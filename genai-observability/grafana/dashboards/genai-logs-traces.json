{
  "__inputs": [
    {
      "name": "DS_GREPTIMEDB",
      "label": "GreptimeDB",
      "type": "datasource",
      "pluginId": "info8fcc-greptimedb-datasource"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "30s",
  "title": "GenAI Logs & Traces",
  "uid": "genai-logs-traces",
  "tags": ["genai", "logs", "traces", "greptimedb"],
  "schemaVersion": 39,
  "version": 2,
  "description": "Correlate conversation logs with trace Gantt charts. Click a Trace ID in Recent Traces to load the Gantt and the logs list beside it.",
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 2,
        "includeAll": false,
        "name": "DS_GREPTIMEDB",
        "options": [],
        "query": "info8fcc-greptimedb-datasource",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": { "text": "", "value": "" },
        "name": "search",
        "label": "Search Logs",
        "type": "textbox",
        "hide": 0
      },
      {
        "current": { "text": "", "value": "" },
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Conversation Logs",
      "description": "LLM prompt and completion logs. Click the trace_id label on any log line to open the Trace Gantt below.",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 1 },
      "datasource": { "type": "info8fcc-greptimedb-datasource", "uid": "${DS_GREPTIMEDB}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "info8fcc-greptimedb-datasource", "uid": "${DS_GREPTIMEDB}" },
          "editorType": "sql",
          "pluginVersion": "3.0.3",
          "queryType": "logs",
          "rawSql": "SELECT timestamp AS timestamp, COALESCE(json_get_string(parse_json(body), 'message.content'), json_get_string(parse_json(body), 'content'), body) AS body, COALESCE(json_get_string(parse_json(body), 'message.role'), severity_text, 'user') AS level, trace_id, span_id FROM genai_conversations WHERE $__timeFilter(timestamp) AND ('${search}' = '' OR matches_term(body, '${search}')) AND ('${trace_id}' = '' OR trace_id = '${trace_id}') ORDER BY timestamp DESC LIMIT 500",
          "builderOptions": {
            "database": "public",
            "table": "genai_conversations",
            "queryType": "logs",
            "columns": [
              { "name": "timestamp", "hint": "time" },
              { "name": "body", "hint": "log_message" },
              { "name": "level", "hint": "log_level" },
              { "name": "trace_id", "hint": "trace_id" },
              { "name": "span_id" }
            ],
            "limit": 500
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "derivedFields": [
          {
            "matcherRegex": "trace_id",
            "matcherType": "label",
            "name": "TraceID",
            "url": "${__url.path}?var-trace_id=${__value.raw}&${__url_time_range}&viewPanel=6",
            "urlDisplayLabel": "View trace Gantt"
          }
        ]
      }
    },

    {
      "id": 4,
      "type": "row",
      "title": "Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent Traces",
      "description": "Root spans in the time range. Click trace_id → View trace + logs (Gantt left, logs right) or View logs only.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "info8fcc-greptimedb-datasource", "uid": "${DS_GREPTIMEDB}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "info8fcc-greptimedb-datasource", "uid": "${DS_GREPTIMEDB}" },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "3.0.3",
          "queryType": "table",
          "rawSql": "SELECT timestamp AS time, trace_id, span_name, service_name, span_status_code AS status, ROUND(duration_nano / 1000000, 0) AS duration_ms FROM opentelemetry_traces WHERE $__timeFilter(timestamp) AND parent_span_id IS NULL AND ('${trace_id}' = '' OR trace_id = '${trace_id}') ORDER BY timestamp DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "trace_id" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View trace",
                    "url": "${__url.path}?var-trace_id=${__data.fields.trace_id}&${__url_time_range}&viewPanel=6",
                    "targetBlank": false
                  },
                  {
                    "title": "View logs",
                    "url": "${__url.path}?var-trace_id=${__data.fields.trace_id}&${__url_time_range}&viewPanel=2",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "duration_ms" },
            "properties": [{ "id": "unit", "value": "ms" }]
          },
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "STATUS_CODE_ERROR": { "color": "red", "text": "ERROR" },
                      "STATUS_CODE_UNSET": { "color": "green", "text": "OK" },
                      "STATUS_CODE_OK": { "color": "green", "text": "OK" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "time", "desc": true }] }
    },
    {
      "id": 6,
      "type": "traces",
      "title": "Trace Gantt",
      "description": "Waterfall / Gantt for the selected Trace ID. If Trace ID is empty, the latest trace in the time range is shown. Logs for the same trace appear on the right.",
      "gridPos": { "h": 16, "w": 14, "x": 0, "y": 24 },
      "datasource": { "type": "info8fcc-greptimedb-datasource", "uid": "${DS_GREPTIMEDB}" },
      "targets": [
        {
          "refId": "Trace ID",
          "datasource": { "type": "info8fcc-greptimedb-datasource", "uid": "${DS_GREPTIMEDB}" },
          "editorType": "sql",
          "format": 3,
          "pluginVersion": "3.0.3",
          "queryType": "traces",
          "rawSql": "SELECT trace_id AS \"traceID\", span_id AS \"spanID\", COALESCE(parent_span_id, '') AS \"parentSpanID\", service_name AS \"serviceName\", span_name AS \"operationName\", CAST(timestamp AS INT64) / 1000000 AS \"startTime\", FLOOR(duration_nano * 0.000001) AS \"duration\", json_to_string(span_events) AS span_events, CASE WHEN span_status_code IN ('Error', 'STATUS_CODE_ERROR') THEN 2 ELSE 0 END AS \"statusCode\", `span_attributes.gen_ai.system`, `span_attributes.gen_ai.operation.name`, `span_attributes.gen_ai.request.model`, `span_attributes.gen_ai.request.max_tokens`, `span_attributes.server.address`, span_status_code, `resource_attributes.telemetry.sdk.name`, `resource_attributes.telemetry.sdk.language`, `resource_attributes.telemetry.sdk.version` FROM opentelemetry_traces WHERE timestamp >= $__fromTime AND timestamp <= $__toTime AND trace_id = COALESCE(NULLIF('${trace_id}', ''), (SELECT trace_id FROM opentelemetry_traces WHERE timestamp >= $__fromTime AND timestamp <= $__toTime ORDER BY timestamp DESC LIMIT 1)) ORDER BY timestamp",
          "meta": {
            "builderOptions": {
              "database": "public",
              "table": "opentelemetry_traces",
              "queryType": "traces",
              "columns": [
                { "name": "trace_id", "hint": "trace_id" },
                { "name": "span_id", "hint": "trace_span_id" },
                { "name": "parent_span_id", "hint": "trace_parent_span_id" },
                { "name": "service_name", "hint": "trace_service_name" },
                { "name": "span_name", "hint": "trace_operation_name" },
                { "name": "timestamp", "hint": "time" },
                { "name": "duration_nano", "hint": "trace_duration_time" },
                { "name": "span_events" },
                { "name": "span_attributes.gen_ai.system", "hint": "trace_tags" },
                { "name": "span_attributes.gen_ai.operation.name", "hint": "trace_tags" },
                { "name": "span_attributes.gen_ai.request.model", "hint": "trace_tags" },
                { "name": "span_attributes.gen_ai.request.max_tokens", "hint": "trace_tags" },
                { "name": "span_attributes.server.address", "hint": "trace_tags" },
                { "name": "span_status_code", "hint": "trace_tags" },
                { "name": "resource_attributes.telemetry.sdk.name", "hint": "trace_service_tags" },
                { "name": "resource_attributes.telemetry.sdk.language", "hint": "trace_service_tags" },
                { "name": "resource_attributes.telemetry.sdk.version", "hint": "trace_service_tags" }
              ],
              "limit": 1000,
              "meta": {
                "traceDurationUnit": "nanoseconds",
                "isTraceIdMode": true
              }
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Logs for this Trace",
      "description": "Conversation logs for the same Trace ID as the Gantt. Updates automatically when Trace ID changes. Empty Trace ID uses the latest trace in the time range.",
      "gridPos": { "h": 16, "w": 10, "x": 14, "y": 24 },
      "datasource": { "type": "info8fcc-greptimedb-datasource", "uid": "${DS_GREPTIMEDB}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "info8fcc-greptimedb-datasource", "uid": "${DS_GREPTIMEDB}" },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "3.0.3",
          "queryType": "table",
          "rawSql": "SELECT timestamp AS time, CASE WHEN json_get_string(parse_json(body), 'message.role') IS NOT NULL THEN json_get_string(parse_json(body), 'message.role') ELSE 'user' END AS role, COALESCE(json_get_string(parse_json(body), 'message.content'), json_get_string(parse_json(body), 'content')) AS content, span_id FROM genai_conversations WHERE $__timeFilter(timestamp) AND trace_id = COALESCE(NULLIF('${trace_id}', ''), (SELECT trace_id FROM opentelemetry_traces WHERE timestamp >= $__fromTime AND timestamp <= $__toTime ORDER BY timestamp DESC LIMIT 1)) ORDER BY timestamp DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "content" },
            "properties": [
              { "id": "custom.width", "value": 360 },
              { "id": "custom.inspect", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "role" },
            "properties": [
              { "id": "custom.width", "value": 80 },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "user": { "color": "blue", "text": "user" },
                      "assistant": { "color": "green", "text": "assistant" },
                      "system": { "color": "orange", "text": "system" },
                      "tool": { "color": "purple", "text": "tool" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "time", "desc": true }] }
    }
  ]
}
