      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "weather-pg"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.latitude, p.longitude, p.rain_mm_h, s.brightness_k,\nround(st_distance_sphere_m(wkt_point_from_latlng(p.latitude,p.longitude),wkt_point_from_latlng(${center_lat},${center_lon}))/1000,1) AS distance_km\nFROM pardig p JOIN satweave s ON p.region_id=s.region_id AND p.grid_id=s.grid_id AND p.ts=s.ts\nWHERE p.region_id=${region:sqlstring} AND s.region_id=${region:sqlstring}\nAND p.ts=CAST(${snapshot} AS TIMESTAMP) AND s.ts=CAST(${snapshot} AS TIMESTAMP)\nORDER BY p.rain_mm_h DESC, p.grid_id LIMIT 15"
        }
      ]
    },
