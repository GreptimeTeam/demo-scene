      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "description": "Exact timestamp + original grid-cell join. No interpolation. Spatial association does not establish causation.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": [
