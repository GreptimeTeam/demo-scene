      "description": "Uses st_distance_sphere_m on WKT points. East Asia center: Shanghai; Bay Area: San Francisco; city selections: that city. Only imported cells contribute.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:mm/h",
          "color": {
