          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, avg(rain_mm_h) AS local_mean, max(rain_mm_h) AS local_peak FROM pardig WHERE region_id = ${region:sqlstring} AND $__timeFilter(ts) AND st_distance_sphere_m(wkt_point_from_latlng(latitude,longitude), wkt_point_from_latlng(${center_lat},${center_lon})) <= ${radius} * 1000 GROUP BY ts ORDER BY ts"
        }
      ]
