{
  "uid": "vibration-lab",
  "title": "Vibration Lab — Synthetic Signals",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "RMS and peak acceleration",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT greptime_timestamp AS time, rms, peak FROM vibration_features WHERE device = 'motor-01' AND $__timeFilter(greptime_timestamp) ORDER BY greptime_timestamp",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "greptimedb-sql"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "accG"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Crest factor",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT greptime_timestamp AS time, crest_factor FROM vibration_features WHERE device = 'motor-01' AND $__timeFilter(greptime_timestamp) ORDER BY greptime_timestamp",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "greptimedb-sql"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Raw waveform — latest 2 seconds",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT greptime_timestamp AS time, acceleration FROM vibration_raw WHERE device = 'motor-01' AND greptime_timestamp > now() - INTERVAL '2 seconds' ORDER BY greptime_timestamp",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "greptimedb-sql"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "accG"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "timeFrom": "2s",
      "hideTimeOverride": false
    },
    {
      "id": 4,
      "title": "Spectrum — latest window (Hz)",
      "type": "barchart",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT frequency, amplitude FROM vibration_spectrum WHERE device = 'motor-01' AND greptime_timestamp = (SELECT max(greptime_timestamp) FROM vibration_spectrum WHERE device = 'motor-01') AND CAST(frequency AS BIGINT) <= 150 ORDER BY CAST(frequency AS BIGINT)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "greptimedb-sql"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "accG"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "frequency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "hertz"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "frequency",
        "orientation": "vertical",
        "showValue": "never",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelSpacing": 100
      }
    },
    {
      "id": 5,
      "title": "Scenario history",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT greptime_timestamp, scenario, rms, peak, crest_factor FROM vibration_features WHERE device = 'motor-01' AND $__timeFilter(greptime_timestamp) ORDER BY greptime_timestamp DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "greptimedb-sql"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "English",
      "type": "link",
      "url": "/d/vibration-lab",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "简体中文",
      "type": "link",
      "url": "/d/vibration-lab-zh",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ]
}
