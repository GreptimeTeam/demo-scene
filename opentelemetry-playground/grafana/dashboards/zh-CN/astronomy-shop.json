  "panels": [
    {
      "id": 1,
      "title": "Astronomy Shop on GreptimeDB",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "请求、日志、trace 和主机指标。选择服务后，从服务表进入 **Services**，从 Trace ID 进入 **Logs & traces**。\n\n[Host metrics](/d/astronomy-host-zh) · [Services](/d/astronomy-services-zh) · [Logs & traces](/d/astronomy-logs-traces-zh)"
      }
    },
    {
      "id": 2,
      "title": "服务端请求量",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "greptimedb"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT COUNT(*) AS value FROM opentelemetry_traces WHERE $__timeFilter(\"timestamp\") AND \"resource_attributes.service.namespace\" = 'opentelemetry-demo' AND service_name IN (${service:sqlstring}) AND span_kind = 'SPAN_KIND_SERVER'"
        }
      ]
    },
    {
      "id": 3,
      "title": "错误率",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "greptimedb"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT SUM(CASE WHEN span_status_code = 'STATUS_CODE_ERROR' THEN 1 ELSE 0 END) * 1.0 / NULLIF(COUNT(*),0) AS value FROM opentelemetry_traces WHERE $__timeFilter(\"timestamp\") AND \"resource_attributes.service.namespace\" = 'opentelemetry-demo' AND service_name IN (${service:sqlstring}) AND span_kind = 'SPAN_KIND_SERVER'"
        }
      ]
    },
    {
      "id": 4,
      "title": "P95 延迟",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "greptimedb"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_nano) / 1e6 AS value FROM opentelemetry_traces WHERE $__timeFilter(\"timestamp\") AND \"resource_attributes.service.namespace\" = 'opentelemetry-demo' AND service_name IN (${service:sqlstring}) AND span_kind = 'SPAN_KIND_SERVER'"
        }
      ]
    },
    {
      "id": 5,
      "title": "活跃服务数",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "greptimedb"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT COUNT(DISTINCT service_name) AS value FROM opentelemetry_traces WHERE $__timeFilter(\"timestamp\") AND \"resource_attributes.service.namespace\" = 'opentelemetry-demo' AND service_name IN (${service:sqlstring}) AND span_kind = 'SPAN_KIND_SERVER'"
        }
      ]
    },
    {
      "id": 6,
      "title": "每分钟请求量",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "greptimedb"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT date_bin(INTERVAL '1 minute', \"timestamp\") AS time, service_name, COUNT(*) AS requests FROM opentelemetry_traces WHERE $__timeFilter(\"timestamp\") AND \"resource_attributes.service.namespace\" = 'opentelemetry-demo' AND service_name IN (${service:sqlstring}) AND span_kind = 'SPAN_KIND_SERVER' GROUP BY time, service_name ORDER BY time"
        }
      ]
    },
    {
      "id": 7,
      "title": "各服务错误率 · Flow",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Flow 每 30 秒更新；当前分钟的数据尚未完整。",
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "greptimedb"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT time_window AS time, service_name, errors * 1.0 / NULLIF(total,0) AS error_rate FROM service_error_rate_1m WHERE $__timeFilter(time_window) AND service_name IN (${service:sqlstring}) ORDER BY time"
        }
      ]
    },
    {
      "id": 8,
      "title": "服务列表 · 选择服务",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service_name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Service details",
                    "url": "/d/astronomy-services-zh?var-service=${__value.raw}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "greptimedb"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT service_name, COUNT(*) AS requests, SUM(CASE WHEN span_status_code = 'STATUS_CODE_ERROR' THEN 1 ELSE 0 END) AS errors, SUM(CASE WHEN span_status_code = 'STATUS_CODE_ERROR' THEN 1 ELSE 0 END) * 1.0 / NULLIF(COUNT(*),0) AS error_rate, approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_nano) / 1e6 AS p95_ms FROM opentelemetry_traces WHERE $__timeFilter(\"timestamp\") AND \"resource_attributes.service.namespace\" = 'opentelemetry-demo' AND service_name IN (${service:sqlstring}) AND span_kind = 'SPAN_KIND_SERVER' GROUP BY service_name ORDER BY requests DESC"
        }
      ]
    },
