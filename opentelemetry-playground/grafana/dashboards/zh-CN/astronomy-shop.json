        "footer": {
          "show": false
        }
      },
      "description": "各信号最近一次写入时间；用于识别无流量和接入中断。",
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "greptimedb"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT 'traces' AS signal, MAX(\"timestamp\") AS last_seen FROM opentelemetry_traces WHERE \"resource_attributes.service.namespace\" = 'opentelemetry-demo' UNION ALL SELECT 'logs', MAX(\"timestamp\") FROM opentelemetry_logs WHERE json_get_string(resource_attributes, '[\"service.namespace\"]') = 'opentelemetry-demo' UNION ALL SELECT 'host metrics', MAX(greptime_timestamp) FROM node_cpu_seconds_total"
        }
      ]
    },
