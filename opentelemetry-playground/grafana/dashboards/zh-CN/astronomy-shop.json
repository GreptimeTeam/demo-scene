        "query": {
          "refId": "var",
          "queryType": "sql",
          "rawSql": "SELECT DISTINCT service_name FROM opentelemetry_traces WHERE \"resource_attributes.service.namespace\" = 'opentelemetry-demo' ORDER BY service_name"
