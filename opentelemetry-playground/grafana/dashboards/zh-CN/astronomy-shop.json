          "queryType": "table",
          "format": 1,
          "rawSql": "WITH logs_by_minute AS (\n  SELECT date_bin(INTERVAL '1 minute', \"timestamp\") AS minute,\n         json_get_string(resource_attributes, '[\"service.name\"]') AS service_name,\n         COUNT(*) AS log_records,\n         SUM(CASE WHEN severity_number >= 17 THEN 1 ELSE 0 END) AS error_logs,\n         SUM(CASE WHEN severity_number BETWEEN 13 AND 16 THEN 1 ELSE 0 END) AS warning_logs\n  FROM opentelemetry_logs\n  WHERE $__timeFilter(\"timestamp\")\n    AND json_get_string(resource_attributes, '[\"service.namespace\"]') = 'opentelemetry-demo'\n  GROUP BY minute, service_name\n), host_by_minute AS (\n  SELECT date_bin(INTERVAL '1 minute', greptime_timestamp) AS minute,\n         AVG(greptime_value) AS vm_available_memory_bytes\n  FROM \"node_memory_MemAvailable_bytes\"\n  WHERE $__timeFilter(greptime_timestamp) AND job = 'node'\n  GROUP BY minute\n)\nSELECT f.time_window, f.service_name, f.total AS server_requests, f.errors AS server_errors,\n       f.errors * 1.0 / NULLIF(f.total, 0) AS error_rate,\n       l.log_records, l.warning_logs, l.error_logs, h.vm_available_memory_bytes\nFROM service_error_rate_1m f\nLEFT JOIN logs_by_minute l ON f.time_window = l.minute AND f.service_name = l.service_name\nLEFT JOIN host_by_minute h ON f.time_window = h.minute\nWHERE f.time_window >= $__fromTime AND f.time_window <= $__toTime\n  AND f.service_name IN (${service:sqlstring})\nORDER BY f.time_window DESC, f.errors DESC\nLIMIT 100"
