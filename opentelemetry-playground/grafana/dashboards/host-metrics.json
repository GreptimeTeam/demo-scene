{
  "title": "Astronomy Shop · Host metrics",
  "uid": "astronomy-host",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "greptimedb",
    "astronomy-shop"
  ],
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/astronomy-shop-greptimedb",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Services",
      "url": "/d/astronomy-services",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Logs & traces",
      "url": "/d/astronomy-logs-traces",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Host metrics",
      "url": "/d/astronomy-host",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "简体中文",
      "url": "/d/astronomy-host-zh",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "greptimedb-promql"
        },
        "query": {
          "query": "label_values(node_uname_info, instance)",
          "refId": "var"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Node exporter",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "node_exporter → Prometheus scrape → GreptimeDB remote write. On macOS, these metrics describe the OrbStack / Docker Linux VM, not macOS itself. Disk capacity and usage are shown by mount point."
      }
    },
    {
      "id": 2,
      "title": "CPU busy",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "greptimedb-promql"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"node\",instance=~\"$instance\",mode=\"idle\"}[5m]))",
          "legendFormat": "CPU busy",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory used",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "greptimedb-promql"
          },
          "expr": "1 - node_memory_MemAvailable_bytes{job=\"node\",instance=~\"$instance\"} / node_memory_MemTotal_bytes{job=\"node\",instance=~\"$instance\"}",
          "legendFormat": "Memory used",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Load / CPU",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "greptimedb-promql"
          },
          "expr": "node_load1{job=\"node\",instance=~\"$instance\"} / count without(cpu,mode) (node_cpu_seconds_total{job=\"node\",instance=~\"$instance\",mode=\"idle\"})",
          "legendFormat": "Load / CPU",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ]
    },
